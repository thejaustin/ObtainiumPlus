<?xml version="1.0" encoding="utf-8"?>
<!--
    No cloud backup: API tokens and store credentials must not leave the
    device. Device-to-device transfer keeps ordinary settings and app data but
    skips flutter_secure_storage, whose keystore-bound keys do not transfer
    (restored ciphertext would be unreadable on the new phone).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
