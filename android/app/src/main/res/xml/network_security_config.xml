<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!--
        Google Play Store DFE endpoints:
        - Only system-trusted CAs allowed — user-installed certs (e.g. corporate
          MitM proxies, mitmproxy, Burp) are explicitly rejected.
        - Cleartext HTTP is forbidden.
        This mirrors Aurora Store's approach and prevents token interception.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">android.clients.google.com</domain>
        <domain includeSubdomains="true">play.googleapis.com</domain>
        <domain includeSubdomains="true">accounts.google.com</domain>
        <trust-anchors>
            <certificates src="system"/>
            <!-- No user certificates for these domains -->
        </trust-anchors>
    </domain-config>

    <!--
        RuStore serves a chain rooted in the Russian Mintsifry CA, which
        Android does not trust. Trust it for that domain only.
    -->
    <domain-config>
        <domain includeSubdomains="true">rustore.ru</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
            <certificates src="@raw/russian_mintsifry_root"/>
        </trust-anchors>
    </domain-config>

    <!--
        All other traffic (GitHub, F-Droid, source scrapers, etc.):
        - Cleartext stays permitted: users track self-hosted / LAN sources
          over plain HTTP (per-app "allow insecure" governs this in Dart).
        - System and user CAs: source requests go through Cronet, which
          verifies with this config, so a private or corporate CA installed
          on the device works for self-hosted sources.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>

</network-security-config>
